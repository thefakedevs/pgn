# Two different DNS A records pointing to this server. Use DNS-only records.
NODE_DOMAIN=vpn.example.com
API_DOMAIN=pg.vpn.example.com

# Copy the exact path from the TLS XHTTP inbound in PasarGuard.
# A leading and trailing slash are required. This is NOT the Reality path.
XHTTP_PATH=/assets/change-me/

# Leave blank on first installation: ./pgn generates and saves a UUID.
# On migration, copy the old API_KEY and state/node/certs/ before starting.
API_KEY=

# Lowercase Compose project name. Keep it unchanged after installation.
COMPOSE_PROJECT_NAME=pgn

# Optional panel update buttons. Install the host service first:
# sudo ./pgn maintenance-install ; sudo ./pgn up
# Uses the existing API_DOMAIN:443 and Unix sockets, with the same API_KEY.
MAINTENANCE_ENABLED=false
